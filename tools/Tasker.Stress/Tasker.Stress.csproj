<Project Sdk="Microsoft.NET.Sdk">

  <!-- Стенд параллельной работы: десять и более клиентов (консоль, MCP, смесь) в одной рабочей области. Запуск — README, «Параллельная работа». -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tasker-stress</AssemblyName>
    <RootNamespace>Tasker.Stress</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Клиенты-консоль и демон — настоящие процессы Rust-программ tasker и tasker-mcpd: они собираются и кладутся рядом со стендом. -->
  <Import Project="..\RustBinaries.targets" />

</Project>
