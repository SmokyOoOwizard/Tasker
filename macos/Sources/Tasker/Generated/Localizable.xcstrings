        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents work with tasks over MCP. The desktop app needs no tokens: MCP is reachable only from this computer, and the agent is chosen in the connect command. Without one, MCP acts as this folder’s “agent”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агенты работают с задачами через MCP. На десктопе токены не нужны: MCP доступен только с этого компьютера, а агент выбирается в команде подключения. Без него MCP работает от имени агента «agent» этой папки."
          }
        }
      }
