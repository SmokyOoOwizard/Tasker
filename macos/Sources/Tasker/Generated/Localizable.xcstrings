    "web.agents.connectDetails" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The MCP address `%1$@` is shared by all folders of the tasker-mcpd daemon; a folder opened in Tasker is added to it automatically (list: `tasker mcp workspace list`). The agent selects a folder with the `workspace` argument of the tools%2$@; if the daemon has only one folder, the argument can be omitted. The list of folders is available through the `list_workspaces` tool. An agent connected with the `%3$@` header acts only in this folder; to work with several folders, connect the agent without the header (in each folder it acts as that folder’s “agent”):"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес MCP `%1$@` у демона tasker-mcpd один на все его папки; открытая в Tasker папка добавляется в них сама (список — `tasker mcp workspace list`). Папку агент указывает аргументом `workspace` инструментов%2$@; если папка у демона одна, аргумент можно опустить. Список папок — инструмент `list_workspaces`. Агент в заголовке `%3$@` действует только в этой папке; чтобы работать с несколькими папками, подключите агента без заголовка (в каждой папке он работает от имени её агента «agent»):"
          }
        }
      }
    },
